# ============================================================
# TVET JOHOR PORTAL — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Supabase or self-hosted)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# Direct connection (required by Prisma for migrations on Supabase)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# ── NextAuth.js / Auth.js ────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_32_CHAR_STRING"
NEXTAUTH_URL="http://localhost:3000"

# ── AWS S3 File Storage ──────────────────────────────────────
# Alternatively, use Supabase Storage (see SUPABASE_ vars below)
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET_NAME="tvet-johor-documents"

# ── Supabase Storage (alternative to S3) ────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Laman Web TVET Negeri Johor"

# ── Upload Limits ────────────────────────────────────────────
MAX_FILE_SIZE_MB="5"
